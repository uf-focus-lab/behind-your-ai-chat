{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@fig/*": ["./assets/*"],
      "@pages/*": ["./pages/*"]
    }
  },
  "include": ["**/*.ts", "**/*.vue", "env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
